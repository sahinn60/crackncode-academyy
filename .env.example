# এই ফাইলটি কপি করে .env.local বানান এবং মানগুলো বদলান।
# সেশন কুকি সাইন করার গোপন কী — অন্তত ৩২ বাইট র‍্যান্ডম স্ট্রিং দিন।
SESSION_SECRET=change-me-with-a-long-random-string

# প্রথমবার ডাটাবেস তৈরি হওয়ার সময় এই অ্যাডমিন অ্যাকাউন্ট তৈরি হয়।
ADMIN_EMAIL=admin@crackncode.academy
ADMIN_PASSWORD=Admin@12345

# চাইলে SQLite ফাইলের পথ বদলানো যাবে (ডিফল্ট: ./data/crackncode.db)
# DATABASE_PATH=/absolute/path/to/crackncode.db
